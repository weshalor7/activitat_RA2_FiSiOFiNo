# Copieu aquest fitxer a ".env" (sense .example) i canvieu els valors.
# docker compose llegeix automàticament el fitxer .env per a la BD de l'aplicació.
# El .env real NO es puja al repositori (és al .gitignore).
# La contrasenya ha de ser la mateixa que DB_PASSWORD al conn.properties.
POSTGRES_USER=fisiofino
POSTGRES_PASSWORD=la_teva_contrasenya
